{
  "name": "stream-cli",
  "version": "0.1.0",
  "description": "CLI to create full project streams for parallel work",
  "private": true,
  "type": "commonjs",
  "bin": {
    "stream": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/ensure-cli-exec.js",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  }
}
